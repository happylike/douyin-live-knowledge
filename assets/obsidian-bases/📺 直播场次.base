filters:
  and:
    - file.ext == "md"
    - file.inFolder(this.file.folder + "/直播场次")
    - 类型 == "直播场次"
properties:
  file.name:
    displayName: 场次笔记
  note.场次编号:
    displayName: 场次编号
  note.主播:
    displayName: 主播
  note.开播时间:
    displayName: 开播时间
  note.整场结束时间:
    displayName: 结束时间
  note.整场时长:
    displayName: 整场时长
  note.处理状态:
    displayName: 处理状态
  note.分段进度:
    displayName: 分段进度
  note.案件数量:
    displayName: 案件数量
  note.核心案件数量:
    displayName: 核心案件
  note.知识点数量:
    displayName: 知识点数量
  note.唠嗑价值数量:
    displayName: 唠嗑价值数量
  note.复核状态:
    displayName: 复核状态
  note.完整文字稿:
    displayName: 完整文字稿
views:
  - type: table
    name: 全部直播场次
    order:
      - file.name
      - 场次编号
      - 主播
      - 开播时间
      - 整场结束时间
      - 整场时长
      - 分段进度
      - 处理状态
      - 案件数量
      - 核心案件数量
      - 知识点数量
      - 唠嗑价值数量
      - 复核状态
      - 完整文字稿
    sort:
      - property: 开播时间
        direction: DESC
